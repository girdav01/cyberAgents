# CyberAgents Environment Configuration

# LLM Provider Configuration
# Options: ollama, lmstudio, openai
LLM_PROVIDER=ollama

# Ollama Configuration (for local deployment)
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI Configuration (if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# LM Studio Configuration (if using LM Studio)
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Application Ports
WEB_UI_PORT=8501
WEBHOOK_PORT=8502

# Webhook Configuration
WEBHOOK_API_KEY=your_secure_webhook_api_key_here

# OpenCTI Configuration
OPENCTI_BASE_URL=http://localhost:8080
OPENCTI_ADMIN_EMAIL=admin@opencti.io
OPENCTI_ADMIN_PASSWORD=ChangeMeNow!
OPENCTI_ADMIN_TOKEN=ChangeMe
OPENCTI_API_KEY=your_opencti_api_key_here

# OpenCTI Dependencies
MINIO_ACCESS_KEY=opencti
MINIO_SECRET_KEY=ChangeMeNow!
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# MISP Configuration
MISP_BASEURL=https://localhost:8443
MISP_ADMIN_EMAIL=admin@misp.local
MISP_ADMIN_PASSPHRASE=admin
MISP_DB_PASSWORD=misp_password
MISP_ROOT_PASSWORD=root_password
MISP_API_KEY=your_misp_api_key_here

# SpiderFoot Configuration
SPIDERFOOT_BASE_URL=http://localhost:5001
SPIDERFOOT_API_KEY=your_spiderfoot_api_key_here

# Trend Micro Vision One Configuration
TREND_VISION_ONE_API_KEY=your_trend_vision_one_api_key_here
TREND_VISION_ONE_BASE_URL=https://api.xdr.trendmicro.com

# VirusTotal Configuration (optional)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Shodan Configuration (optional)
SHODAN_API_KEY=your_shodan_api_key_here

# Logging Configuration
LOG_LEVEL=INFO
